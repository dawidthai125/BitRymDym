# BitRymDym — environment placeholders
# Copy to .env.local and fill with real values from your Supabase project.
# NEVER commit secrets. NEVER put service role keys in NEXT_PUBLIC_*.

# --- Required for Auth / client + server (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LOCAL BPM E2E only (never production) ---
# Prefer a separate gitignored file: copy env.local.e2e.example → .env.local.e2e
# Fill keys from `supabase status -o env` after Docker + `supabase start`.
# Guard before mutating tests:
#   npx tsx scripts/_assert-local-supabase-env.ts --env-file .env.local.e2e
# Must print: SUPABASE ENVIRONMENT = LOCAL
# If URL contains *.supabase.co → ABORT (do not run READY E2E).
# Do NOT overwrite production .env.local with these values blindly.

# Canonical public origin for Auth email redirects (production).
# Production MUST be https://bitrymdym.pl — never a *.vercel.app deployment URL.
# Preview/local may omit this; code falls back to VERCEL_URL (preview) or localhost.
NEXT_PUBLIC_SITE_URL=https://bitrymdym.pl

# --- Server-only (operator / elevated server tasks) ---
# Do not expose to the browser or Client Components.
SUPABASE_SERVICE_ROLE_KEY=

# --- FAR-01 production dry-run operator env (gitignored local file preferred) ---
# Use a dedicated gitignored file such as .env.far01.local — never commit JWTs.
# FAR01_DRYRUN_SUPABASE_URL=
# FAR01_DRYRUN_CREDENTIAL_CLASS=readonly
# FAR01_DRYRUN_READONLY_KEY=          # R1 JWT only (Authorization Bearer) — NOT apikey
# FAR01_DRYRUN_API_KEY=              # optional; else NEXT_PUBLIC_SUPABASE_ANON_KEY is used as apikey
# Never set FAR01_DRYRUN_API_KEY / FAR01_DRYRUN_READONLY_KEY to the service-role key.

# --- FAR-01 LIVE mutator operator env (same gitignored file; separate from R1) ---
# Architect GO: credential provisioning only — NOT Canary / Backfill.
# FAR01_LIVE_SUPABASE_URL=
# FAR01_LIVE_CREDENTIAL_CLASS=live_mutator
# FAR01_LIVE_MUTATOR_KEY=            # LIVE JWT only (role=far01_live_mutator) — NOT apikey / NOT R1
# FAR01_LIVE_API_KEY=                # optional; else NEXT_PUBLIC_SUPABASE_ANON_KEY is used as apikey
# Mint helper (local): SUPABASE_JWT_SECRET=... npx tsx scripts/far01-mint-role-jwt.ts live_mutator
# Remint R1 if expired: SUPABASE_JWT_SECRET=... npx tsx scripts/far01-mint-role-jwt.ts readonly
# Never set FAR01_LIVE_* to the service-role key. Never reuse R1 JWT as LIVE.

# Vercel Cron / manual janitor auth for /api/cron/takes-janitor (Wave 4).
# Required in production when cron is enabled. Never expose to the browser.
CRON_SECRET=

# SFM Foundation Stage A — Accept / domain stages (GO-SFM-IMPL-A).
# Default OFF. Local/dev only until Owner cutover GO. Never enables Contabo jobs.
# SFM_VERSIONS_V1=false

# SFM dedicated worker process kill switch (GO-SFM-WORKER-ENTRY).
# Default OFF. Independent of SFM_VERSIONS_V1. Both must be true to claim.
# Does NOT auto-start Contabo/systemd. Staging/ops require separate Owner GO.
# SFM_WORKER_ENABLED=false
# SFM_WORKER_REF=sfm-poller-local-1
# SFM_WORKER_POLL_MS=2000

# Apply identity migration before live Auth/RLS verification:
#   supabase/migrations/20260925120000_phase_1_3_identity.sql
#
# --- W4 Admin account deletion mail (Resend, server-only) ---
# Never expose to the browser or Client Components. Never commit values.
# RESEND_FROM_EMAIL must be a verified Resend sender (operator-configured).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- STORAGE-ARCH-07 backup plane (operator-only; never NEXT_PUBLIC; never Vercel runtime) ---
# Dedicated AWS account keys — NOT Supabase service_role.
# Do not create these until Phase A Object Lock COMPLIANCE is proven.
# SA07_AWS_REGION=eu-central-1
# SA07_BACKUP_BUCKET=bitrymdym-beat-audio-backup
# SA07_BACKUP_RESTORE_BUCKET=bitrymdym-beat-audio-restore-drill
# SA07_OPERATOR=owner
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Never grant backup IAM to SUPABASE_SERVICE_ROLE_KEY. Never commit values.

# --- One-off Przelewy24 checkout (server-only; never NEXT_PUBLIC) ---
# Checkout stays hidden until BOTH the flag and every P24 variable are set.
# P24_SANDBOX must be the word true or false (no default — missing means off).
# Amounts come from src/config/plan-policy.ts. A flag change needs a redeploy.
# Sandbox panel: https://sandbox.przelewy24.pl
# Webhook (urlStatus) must be a public HTTPS URL: {SITE}/api/webhooks/p24
# Return page: {SITE}/premium/return/{sessionId}
# PLAN_PAYMENTS_AVAILABLE=false
# P24_MERCHANT_ID=
# P24_POS_ID=
# P24_CRC=
# P24_API_KEY=
# P24_SANDBOX=true

# BITEK chat (server-only; leave empty to disable a provider — chain: Groq → Gemini → E3 → rules)
GROQ_API_KEY=
# BITEK_GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
# BITEK_GEMINI_MODEL=gemini-3.5-flash-lite
# E3 self-hosted model via the bitek_llm_jobs DB queue (needs SUPABASE_SERVICE_ROLE_KEY; E3 runs npm run bitek:llm:worker)
BITEK_E3_QUEUE_ENABLED=false

# ---------------------------------------------------------------------------
# E-mail notifications (welcome, beat moderation result, master ready, MP4 ready)
# OFF unless ALL are set: EMAIL_NOTIFICATIONS_ENABLED=true + RESEND_API_KEY + RESEND_FROM_EMAIL
# + EMAIL_UNSUBSCRIBE_SECRET (>= 32 random chars, e.g. `openssl rand -base64 48`).
# Set on Vercel (welcome, moderation) AND on the E3 worker (master / MP4 ready; also
# NEXT_PUBLIC_SITE_URL there so links point at production). Migration 20261030210000.
# RESEND_FROM_EMAIL must be on a domain verified in Resend, e.g. "BitRymDym <powiadomienia@twojadomena.pl>".
# ---------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_UNSUBSCRIBE_SECRET=
# Optional reply-to address for notifications
EMAIL_REPLY_TO=
