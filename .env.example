# BitRymDym — environment placeholders
# Copy to .env.local and fill with real values from your Supabase project.
# NEVER commit secrets. NEVER put service role keys in NEXT_PUBLIC_*.

# --- Required for Auth / client + server (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin for Auth email redirects (production).
# Production MUST be https://bitrymdym.pl — never a *.vercel.app deployment URL.
# Preview/local may omit this; code falls back to VERCEL_URL (preview) or localhost.
NEXT_PUBLIC_SITE_URL=https://bitrymdym.pl

# --- Server-only (operator / elevated server tasks) ---
# Do not expose to the browser or Client Components.
SUPABASE_SERVICE_ROLE_KEY=

# Apply identity migration before live Auth/RLS verification:
#   supabase/migrations/20260925120000_phase_1_3_identity.sql
#
# LIVE VERIFICATION remains BLOCKED until real credentials are set in .env.local.
