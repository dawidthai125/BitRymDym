{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupReaderAllow",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET",
        "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/*"
      ]
    },
    {
      "Sid": "BackupReaderDenyMutate",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET",
        "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/*"
      ]
    }
  ]
}
