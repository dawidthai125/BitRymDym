# BitRymDym — LOCAL E2E env template (safe to commit as EXAMPLE only)
# Copy to gitignored `.env.local.e2e` AFTER `supabase start` succeeds.
#
# CRITICAL:
# - Do NOT copy values from production `.env.local`
# - Do NOT put *.supabase.co URLs here
# - Do NOT paste production service_role keys
#
# Fill from: `supabase status -o env`
# API port is 54421 in supabase/config.toml (off the Windows excluded range 54224–54323).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY_FROM_SUPABASE_STATUS
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY_FROM_SUPABASE_STATUS

# Local app origin (Auth redirects)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional local-only markers (read by guard scripts)
BITRYMDYM_E2E_ENV=local
